{
  "info": {
    "name": "ProyectoBD X-AUST",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login coach válido",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
        "url": {"raw": "{{base_url}}/main/login.php", "host": ["{{base_url}}"], "path": ["main", "login.php"]},
        "body": {"mode": "urlencoded", "urlencoded": [{"key": "username", "value": "1"}]}
      },
      "event": [
        {"listen": "test", "script": {"exec": [
          "pm.test('Status 302 redirect o 200 tras seguir redirect', function(){ pm.expect([200,302]).to.include(pm.response.code); });",
          "pm.test('Llegó a coach/index.php (éxito 2xx)', function(){ pm.expect(pm.response.code).to.be.oneOf([200,302]); });",
          "pm.test('Tiempo < 2s', function(){ pm.expect(pm.response.responseTime).to.be.below(2000); });"
        ]}}
      ]
    },
    {
      "name": "Check-In ID inválido",
      "request": {
        "method": "POST",
        "url": {"raw": "{{base_url}}/main/checkIn.php", "host": ["{{base_url}}"], "path": ["main", "checkIn.php"]},
        "body": {"mode": "urlencoded", "urlencoded": [{"key": "idCliente", "value": "999999"}]}
      },
      "event": [
        {"listen": "test", "script": {"exec": [
          "pm.test('Status 200', function(){ pm.response.to.have.status(200); });",
          "pm.test('Muestra mensaje de no encontrado', function(){ pm.expect(pm.response.text()).to.include('No se encontró'); });",
          "pm.test('No es un error 500', function(){ pm.expect(pm.response.code).to.not.equal(500); });"
        ]}}
      ]
    },
    {
      "name": "Consultar Clientes",
      "request": {"method": "GET", "url": {"raw": "{{base_url}}/admin/consultarClientes.php", "host": ["{{base_url}}"], "path": ["admin", "consultarClientes.php"]}},
      "event": [
        {"listen": "test", "script": {"exec": [
          "pm.test('Status 200', function(){ pm.response.to.have.status(200); });",
          "pm.test('Contiene tabla de clientes', function(){ pm.expect(pm.response.text()).to.include('ID Cliente'); });",
          "pm.test('Content-Type HTML', function(){ pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html'); });"
        ]}}
      ]
    }
  ],
  "variable": [{"key": "base_url", "value": "http://localhost/proyectoBD"}]
}
